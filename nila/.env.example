# Nila configuration
# Copy this file to `.env` and fill in your values, OR set your key from the
# in-app Settings panel (which stores it in Nila's local config, not this file).

# Your Anthropic API key. Required for AI chat, research, and screenshot analysis.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Default model for chat. One of:
#   claude-opus-4-8      (most capable — default)
#   claude-sonnet-5      (balanced)
#   claude-haiku-4-5-20251001 (fastest)
NILA_MODEL=claude-opus-4-8

# Optional: override where Nila stores its SQLite database and config.
# Defaults to the OS-standard app-data directory (e.g. ~/.config/nila on Linux).
# NILA_DATA_DIR=
